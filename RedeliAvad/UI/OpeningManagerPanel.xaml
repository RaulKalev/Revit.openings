<UserControl
    x:Class="RedeliAvad.OpeningManagerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:RedeliAvad"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="560"
    d:DesignWidth="780"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--  Parse-time only; cleared in code-behind so DynamicResource follows the window theme  -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ComboBox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/RedeliAvad;component/UI/Themes/ElementStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!--  Filter chip (matches CustomActionButtonStyle language, pill shaped)  -->
            <Style x:Key="FilterChipStyle" TargetType="{x:Type ToggleButton}">
                <Setter Property="Height" Value="24" />
                <Setter Property="Margin" Value="0,0,6,4" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border
                                x:Name="ChipBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource IconHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource HighlightBrush}" />
                                    <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource IconHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  Small icon button used inside grid rows  -->
            <Style x:Key="RowIconButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Margin" Value="1,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border
                                x:Name="IconBg"
                                Background="Transparent"
                                CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="IconBg" Property="Background" Value="{DynamicResource HighlightBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.3" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  DataGrid row/cell theming (keeps the plugin's flat look, clear selection accent)  -->
            <Style x:Key="ManagerRowStyle" TargetType="{x:Type DataGridRow}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="MinHeight" Value="30" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HighlightBrush}" />
                    </Trigger>
                    <!--  Selected row: theme accent (dark: #0078D7, light: #CDEAFF)  -->
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TextHighlightBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ManagerCellStyle" TargetType="{x:Type DataGridCell}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Border
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Panel header  -->
        <Grid Grid.Row="0" Margin="2,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="Bold"
                Foreground="{DynamicResource ForegroundBrush}"
                Text="Avade haldur" />
            <Button
                Grid.Column="1"
                Click="ClosePanel_Click"
                Style="{StaticResource RowIconButtonStyle}"
                ToolTip="Sulge haldur">
                <materialDesign:PackIcon
                    Width="18"
                    Height="18"
                    Foreground="{DynamicResource IconBrush}"
                    Kind="CloseCircleOutline" />
            </Button>
        </Grid>

        <!--  Search + filters (MaterialDesign Card)  -->
        <materialDesign:Card
            Grid.Row="1"
            Padding="8,6"
            Background="{DynamicResource SecondaryBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Search + validate row  -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Height="26">
                        <TextBox
                            x:Name="SearchBox"
                            Padding="6,0"
                            HorizontalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            FontSize="12"
                            Style="{StaticResource CustomTextBoxStyle}"
                            TextChanged="SearchBox_TextChanged" />
                        <TextBlock
                            Margin="8,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource IconForegroundBrush}"
                            IsHitTestVisible="False"
                            Text="Otsi ava, allikat, alust, korrust...">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <StackPanel
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Orientation="Horizontal">
                        <Button
                            x:Name="ValidateButton"
                            Width="110"
                            Height="26"
                            Click="Validate_Click"
                            Content="Valideeri"
                            FontSize="12"
                            Style="{StaticResource CustomActionButtonStyle}"
                            ToolTip="Skaneeri mudel ja valideeri kõik hallatavad avad" />
                    </StackPanel>
                </Grid>

                <Separator Grid.Row="1" Opacity="0.2" />

                <!--  Filter chips  -->
                <WrapPanel Grid.Row="2" Orientation="Horizontal">
                    <ToggleButton
                        x:Name="ChipAll"
                        Click="Chip_Click"
                        Content="Kõik"
                        IsChecked="True"
                        Style="{StaticResource FilterChipStyle}"
                        Tag="All" />
                    <ToggleButton
                        Click="Chip_Click"
                        Content="Vertikaalne"
                        Style="{StaticResource FilterChipStyle}"
                        Tag="Vertical" />
                    <ToggleButton
                        Click="Chip_Click"
                        Content="Horisontaalne"
                        Style="{StaticResource FilterChipStyle}"
                        Tag="Horizontal" />
                    <ToggleButton
                        Click="Chip_Click"
                        Content="Joondatud"
                        Style="{StaticResource FilterChipStyle}"
                        Tag="Aligned" />
                    <ToggleButton
                        Click="Chip_Click"
                        Content="Joondamata"
                        Style="{StaticResource FilterChipStyle}"
                        Tag="NotAligned" />
                    <ToggleButton
                        Click="Chip_Click"
                        Content="Vajab ülevaatust"
                        Style="{StaticResource FilterChipStyle}"
                        Tag="NeedsReview" />
                    <ToggleButton
                        Click="Chip_Click"
                        Content="Lubatud"
                        Style="{StaticResource FilterChipStyle}"
                        Tag="Allowed" />
                    <ToggleButton
                        Click="Chip_Click"
                        Content="Puudub"
                        Style="{StaticResource FilterChipStyle}"
                        Tag="Missing" />
                </WrapPanel>
            </Grid>
        </materialDesign:Card>

        <!--  Openings list (MaterialDesign Card)  -->
        <materialDesign:Card
            Grid.Row="2"
            Margin="0,10,0,0"
            Padding="5"
            Background="{DynamicResource SecondaryBackgroundBrush}">
            <DataGrid
                x:Name="ItemsGrid"
                AutoGenerateColumns="False"
                Background="Transparent"
                BorderThickness="0"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeRows="False"
                CellStyle="{StaticResource ManagerCellStyle}"
                ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                EnableRowVirtualization="True"
                FontSize="11"
                Foreground="{DynamicResource ForegroundBrush}"
                GridLinesVisibility="None"
                HeadersVisibility="Column"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                MouseDoubleClick="ItemsGrid_MouseDoubleClick"
                RowHeaderWidth="0"
                RowStyle="{StaticResource ManagerRowStyle}"
                SelectionChanged="ItemsGrid_SelectionChanged"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>

                    <!--  Status  -->
                    <DataGridTemplateColumn Width="120" Header="Staatus">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding NotesText}">
                                    <Ellipse
                                        Width="9"
                                        Height="9"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Fill="{Binding StatusColor}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{DynamicResource ForegroundBrush}"
                                        Text="{Binding StatusText}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--  Source  -->
                    <DataGridTemplateColumn Width="*" MinWidth="105" Header="Allikas">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" ToolTip="{Binding SourceTypeName}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource ForegroundBrush}"
                                        Text="{Binding SourceDisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="9.5"
                                        Foreground="{DynamicResource IconForegroundBrush}"
                                        Text="{Binding SourceCategory}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--  Host  -->
                    <DataGridTemplateColumn Width="*" MinWidth="105" Header="Alus">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" ToolTip="{Binding HostCategory}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource ForegroundBrush}"
                                        Text="{Binding HostDisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="9.5"
                                        Foreground="{DynamicResource IconForegroundBrush}"
                                        Text="{Binding HostModelName}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--  Opening type  -->
                    <DataGridTemplateColumn Width="*" MinWidth="90" Header="Ava tüüp">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" ToolTip="{Binding OpeningFamilyName}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource ForegroundBrush}"
                                        Text="{Binding OpeningTypeName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="9.5"
                                        Foreground="{DynamicResource IconForegroundBrush}"
                                        Text="{Binding OrientationText}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--  Size  -->
                    <DataGridTextColumn
                        Width="78"
                        Binding="{Binding SizeText}"
                        Header="Mõõdud (mm)" />

                    <!--  Offset  -->
                    <DataGridTextColumn
                        Width="56"
                        Binding="{Binding OffsetText}"
                        Header="Nihe" />

                    <!--  Level  -->
                    <DataGridTextColumn
                        Width="66"
                        Binding="{Binding LevelName}"
                        Header="Korrus" />

                    <!--  Row actions  -->
                    <DataGridTemplateColumn
                        Width="215"
                        CanUserResize="False"
                        Header="Tegevused">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Click="GoTo_Click"
                                        Style="{StaticResource RowIconButtonStyle}"
                                        ToolTip="Mine ava juurde">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Foreground="{DynamicResource IconBrush}"
                                            Kind="CrosshairsGps" />
                                    </Button>
                                    <Button
                                        Click="SelectOpening_Click"
                                        Style="{StaticResource RowIconButtonStyle}"
                                        ToolTip="Vali ava">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Foreground="{DynamicResource IconBrush}"
                                            Kind="CursorDefault" />
                                    </Button>
                                    <Button
                                        Click="SelectSource_Click"
                                        Style="{StaticResource RowIconButtonStyle}"
                                        ToolTip="Vali allikas">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Foreground="{DynamicResource IconBrush}"
                                            Kind="Magnify" />
                                    </Button>
                                    <Button
                                        Click="HighlightPair_Click"
                                        Style="{StaticResource RowIconButtonStyle}"
                                        ToolTip="Näita paari (ava + allikas + alus)">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Foreground="{DynamicResource IconBrush}"
                                            Kind="EyeOutline" />
                                    </Button>
                                    <Button
                                        Click="Fix_Click"
                                        IsEnabled="{Binding CanFix}"
                                        Style="{StaticResource RowIconButtonStyle}"
                                        ToolTip="Paranda / uuenda ava">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Foreground="{DynamicResource IconBrush}"
                                            Kind="Wrench" />
                                    </Button>
                                    <Button
                                        Click="MarkAllowed_Click"
                                        Style="{StaticResource RowIconButtonStyle}"
                                        ToolTip="Märgi lubatuks">
                                        <Button.Visibility>
                                            <Binding Converter="{StaticResource BoolToVis}" Path="IsAllowedInverse" />
                                        </Button.Visibility>
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Foreground="{DynamicResource IconBrush}"
                                            Kind="ShieldCheckOutline" />
                                    </Button>
                                    <Button
                                        Click="ClearAllowed_Click"
                                        Style="{StaticResource RowIconButtonStyle}"
                                        ToolTip="Eemalda lubatud märge"
                                        Visibility="{Binding IsAllowed, Converter={StaticResource BoolToVis}}">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Foreground="{DynamicResource IconBrush}"
                                            Kind="ShieldOffOutline" />
                                    </Button>
                                    <Button
                                        Click="Unlink_Click"
                                        Style="{StaticResource RowIconButtonStyle}"
                                        ToolTip="Eemalda seos (ava jääb alles)">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Foreground="{DynamicResource IconBrush}"
                                            Kind="LinkOff" />
                                    </Button>
                                    <Button
                                        Click="DeleteOpening_Click"
                                        Style="{StaticResource RowIconButtonStyle}"
                                        ToolTip="Kustuta ava">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Foreground="{DynamicResource IconBrush}"
                                            Kind="DeleteOutline" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

        <!--  Details / preview (MaterialDesign Card)  -->
        <materialDesign:Card
            Grid.Row="3"
            Margin="0,10,0,0"
            Padding="8,6"
            Background="{DynamicResource SecondaryBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Alignment schematic preview (click = go to opening)  -->
                <Border
                    Grid.Column="0"
                    Width="210"
                    Height="104"
                    Margin="0,2,10,2"
                    Background="{DynamicResource PrimaryBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Cursor="Hand"
                    MouseLeftButtonUp="Preview_MouseLeftButtonUp"
                    ToolTip="Kliki, et liikuda ava juurde mudelis">
                    <Canvas
                        x:Name="PreviewCanvas"
                        ClipToBounds="True"
                        Background="Transparent" />
                </Border>

                <!--  Selected item info  -->
                <StackPanel
                    Grid.Column="1"
                    Margin="0,2,10,0"
                    VerticalAlignment="Top">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text="Valitud ava" />
                    <Separator Margin="0,2,0,4" Opacity="0.2" />
                    <TextBlock
                        x:Name="DetailLine1"
                        FontSize="11"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text="–"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="DetailLine2"
                        FontSize="11"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text=""
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="DetailLine3"
                        FontSize="11"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text=""
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="DetailLine4"
                        FontSize="11"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text=""
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!--  Notes / allowed reason  -->
                <StackPanel
                    Grid.Column="2"
                    Margin="0,2,0,0"
                    VerticalAlignment="Top">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text="Märkused" />
                    <Separator Margin="0,2,0,4" Opacity="0.2" />
                    <TextBlock
                        x:Name="DetailNotes"
                        FontSize="11"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text="–"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!--  Bottom Bar  -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    x:Name="SummaryText"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource ForegroundBrush}"
                    Text="Vajuta „Valideeri“, et laadida avad." />
                <TextBlock
                    x:Name="StatusMessageText"
                    Margin="14,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource IconForegroundBrush}"
                    Text=""
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button
                    x:Name="FixSelectedButton"
                    Width="140"
                    Height="30"
                    Click="FixSelected_Click"
                    Content="Paranda valitud"
                    FontSize="12"
                    Style="{StaticResource CustomActionButtonStyle}"
                    ToolTip="Paranda kõik valitud read (kinnitusega)" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
