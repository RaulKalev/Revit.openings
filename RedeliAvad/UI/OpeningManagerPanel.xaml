<UserControl
    x:Class="RedeliAvad.OpeningManagerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:RedeliAvad"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="780"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--  Styles only (shared instance); colours resolve against the window's active palette  -->
            <ResourceDictionary.MergedDictionaries>
                <local:SharedDictionary Source="pack://application:,,,/RedeliAvad;component/UI/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Two-line cell: primary value + tertiary caption  -->
            <Style x:Key="CellPrimary" TargetType="{x:Type TextBlock}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            </Style>
            <Style x:Key="CellCaption" TargetType="{x:Type TextBlock}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
            </Style>
            <Style x:Key="DetailLabel" BasedOn="{StaticResource Type.Label}" TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="0,0,12,6" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
            <Style x:Key="DetailValue" TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="MenuIcon" TargetType="{x:Type materialDesign:PackIcon}">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16,4,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header: title, validate, close  -->
        <DockPanel Margin="0,8,0,12">
            <Button
                Margin="8,0,0,0"
                AutomationProperties.Name="Close opening manager"
                Click="ClosePanel_Click"
                DockPanel.Dock="Right"
                Style="{StaticResource Button.Icon}"
                ToolTip="Sulge haldur">
                <materialDesign:PackIcon
                    Width="16"
                    Height="16"
                    Kind="Close" />
            </Button>
            <Button
                x:Name="ValidateButton"
                Click="Validate_Click"
                DockPanel.Dock="Right"
                Style="{StaticResource Button.Secondary}"
                ToolTip="Skaneeri mudel ja valideeri kõik hallatavad avad (F5)">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Style="{StaticResource ButtonIconLabel}" />
                    <TextBlock Text="Valideeri" />
                </StackPanel>
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Type.Title}" Text="Avade haldur" />
                <TextBlock
                    x:Name="SummaryText"
                    Margin="0,2,0,0"
                    Style="{StaticResource Type.Secondary}"
                    Text="Vajuta „Valideeri“, et laadida avad."
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </DockPanel>

        <!--  Search  -->
        <Grid Grid.Row="1" Margin="{StaticResource Gap.Bottom.S}">
            <TextBox
                x:Name="SearchBox"
                Padding="30,0,8,0"
                AutomationProperties.Name="Search openings"
                Style="{StaticResource Input.Text}"
                Tag="Otsi ava, allikat, alust, korrust…"
                TextChanged="SearchBox_TextChanged" />
            <materialDesign:PackIcon
                Width="16"
                Height="16"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource Text.Tertiary}"
                IsHitTestVisible="False"
                Kind="Magnify" />
        </Grid>

        <!--  Filter chips (single choice)  -->
        <WrapPanel
            x:Name="ChipPanel"
            Grid.Row="2"
            Margin="0,2,0,6"
            AutomationProperties.Name="Filter">
            <RadioButton
                x:Name="ChipAll"
                Checked="Chip_Checked"
                Content="Kõik"
                GroupName="OpeningFilter"
                IsChecked="True"
                Style="{StaticResource Chip}"
                Tag="All" />
            <RadioButton
                Checked="Chip_Checked"
                Content="Vajab ülevaatust"
                GroupName="OpeningFilter"
                Style="{StaticResource Chip}"
                Tag="NeedsReview" />
            <RadioButton
                Checked="Chip_Checked"
                Content="Joondamata"
                GroupName="OpeningFilter"
                Style="{StaticResource Chip}"
                Tag="NotAligned" />
            <RadioButton
                Checked="Chip_Checked"
                Content="Puudub"
                GroupName="OpeningFilter"
                Style="{StaticResource Chip}"
                Tag="Missing" />
            <RadioButton
                Checked="Chip_Checked"
                Content="Joondatud"
                GroupName="OpeningFilter"
                Style="{StaticResource Chip}"
                Tag="Aligned" />
            <RadioButton
                Checked="Chip_Checked"
                Content="Lubatud"
                GroupName="OpeningFilter"
                Style="{StaticResource Chip}"
                Tag="Allowed" />
            <Border
                Width="1"
                Height="16"
                Margin="4,0,10,6"
                VerticalAlignment="Center"
                Background="{DynamicResource Separator}" />
            <RadioButton
                Checked="Chip_Checked"
                Content="Vertikaalne"
                GroupName="OpeningFilter"
                Style="{StaticResource Chip}"
                Tag="Vertical" />
            <RadioButton
                Checked="Chip_Checked"
                Content="Horisontaalne"
                GroupName="OpeningFilter"
                Style="{StaticResource Chip}"
                Tag="Horizontal" />
        </WrapPanel>

        <!--  Openings list  -->
        <Border Grid.Row="3" Style="{StaticResource Surface}">
            <Grid>
                <DataGrid
                    x:Name="ItemsGrid"
                    Padding="0,4"
                    AutomationProperties.Name="Managed openings"
                    MouseDoubleClick="ItemsGrid_MouseDoubleClick"
                    SelectionChanged="ItemsGrid_SelectionChanged"
                    SelectionMode="Extended"
                    Style="{StaticResource TableGrid}">
                    <DataGrid.Columns>
                        <!--  Status: glyph + word (never colour alone)  -->
                        <DataGridTemplateColumn
                            Width="172"
                            Header="Staatus"
                            SortMemberPath="StatusText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel ToolTip="{Binding NotesText}">
                                        <materialDesign:PackIcon Style="{StaticResource StatusIcon}" />
                                        <TextBlock Style="{StaticResource StatusText}" Text="{Binding StatusText}" />
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            Width="*"
                            MinWidth="110"
                            Header="Allikas"
                            SortMemberPath="SourceDisplayName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4" ToolTip="{Binding SourceTypeName}">
                                        <TextBlock Style="{StaticResource CellPrimary}" Text="{Binding SourceDisplayName}" />
                                        <TextBlock Style="{StaticResource CellCaption}" Text="{Binding SourceCategory}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            Width="*"
                            MinWidth="110"
                            Header="Alus"
                            SortMemberPath="HostDisplayName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4" ToolTip="{Binding HostCategory}">
                                        <TextBlock Style="{StaticResource CellPrimary}" Text="{Binding HostDisplayName}" />
                                        <TextBlock Style="{StaticResource CellCaption}" Text="{Binding HostModelName}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            Width="*"
                            MinWidth="96"
                            Header="Ava"
                            SortMemberPath="OpeningTypeName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4" ToolTip="{Binding OpeningFamilyName}">
                                        <TextBlock Style="{StaticResource CellPrimary}" Text="{Binding OpeningTypeName}" />
                                        <TextBlock Style="{StaticResource CellCaption}">
                                            <Run Text="{Binding SizeText, Mode=OneWay}" />
                                            <Run Text="{Binding OrientationText, Mode=OneWay, StringFormat=' · {0}'}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn
                            Width="76"
                            Binding="{Binding OffsetText}"
                            Header="Nihe"
                            SortMemberPath="OffsetMm" />

                        <DataGridTextColumn
                            Width="76"
                            Binding="{Binding LevelName}"
                            Header="Korrus" />

                        <!--  Row actions: the frequent two, the rest in "…"  -->
                        <DataGridTemplateColumn Width="100" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button
                                            AutomationProperties.Name="Go to opening"
                                            Click="GoTo_Click"
                                            Style="{StaticResource Button.Icon}"
                                            ToolTip="Mine ava juurde">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="CrosshairsGps" />
                                        </Button>
                                        <Button
                                            AutomationProperties.Name="Fix opening"
                                            Click="Fix_Click"
                                            IsEnabled="{Binding CanFix}"
                                            Style="{StaticResource Button.Icon}"
                                            ToolTip="Paranda / uuenda ava">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="AutoFix" />
                                        </Button>
                                        <Button
                                            AutomationProperties.Name="More actions"
                                            Click="More_Click"
                                            Style="{StaticResource Button.Icon}"
                                            ToolTip="Rohkem tegevusi">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="DotsHorizontal" />
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Click="SelectOpening_Click" Header="Vali ava">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="CursorDefaultOutline" Style="{StaticResource MenuIcon}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Click="SelectSource_Click" Header="Vali allikas">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="SelectSearch" Style="{StaticResource MenuIcon}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Click="HighlightPair_Click" Header="Näita paari (ava + allikas + alus)">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="EyeOutline" Style="{StaticResource MenuIcon}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator Style="{StaticResource MenuSeparator}" />
                                                    <MenuItem
                                                        Click="MarkAllowed_Click"
                                                        Header="Märgi lubatuks…"
                                                        Visibility="{Binding IsAllowedInverse, Converter={StaticResource BoolToVis}}">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="ShieldCheckOutline" Style="{StaticResource MenuIcon}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem
                                                        Click="ClearAllowed_Click"
                                                        Header="Eemalda lubatud märge"
                                                        Visibility="{Binding IsAllowed, Converter={StaticResource BoolToVis}}">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="ShieldOffOutline" Style="{StaticResource MenuIcon}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Click="Unlink_Click" Header="Eemalda seos…">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="LinkOff" Style="{StaticResource MenuIcon}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator Style="{StaticResource MenuSeparator}" />
                                                    <MenuItem
                                                        Click="DeleteOpening_Click"
                                                        Foreground="{DynamicResource Status.Error}"
                                                        Header="Kustuta ava…">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="DeleteOutline" Style="{StaticResource MenuIcon}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!--  Empty / no-match state: says what to do  -->
                <StackPanel
                    x:Name="EmptyState"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <materialDesign:PackIcon
                        x:Name="EmptyIcon"
                        Width="32"
                        Height="32"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource Text.Tertiary}"
                        Kind="TableSearch" />
                    <TextBlock
                        x:Name="EmptyTitle"
                        HorizontalAlignment="Center"
                        Style="{StaticResource Type.Section}"
                        Text="Avasid pole laaditud" />
                    <TextBlock
                        x:Name="EmptyMessage"
                        MaxWidth="320"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource Type.Secondary}"
                        Text="Vajuta „Valideeri“, et mudel läbi vaadata."
                        TextAlignment="Center" />
                    <Button
                        x:Name="EmptyAction"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        Click="EmptyAction_Click"
                        Content="Valideeri"
                        Style="{StaticResource Button.Secondary}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Selected opening  -->
        <Border
            Grid.Row="4"
            Margin="{StaticResource Gap.Top.M}"
            Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Alignment schematic (click = go to opening)  -->
                <Border
                    x:Name="PreviewBox"
                    Width="210"
                    Height="110"
                    Margin="0,0,16,0"
                    VerticalAlignment="Top"
                    Background="{DynamicResource Surface.Inset}"
                    BorderBrush="{DynamicResource Surface.Stroke}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Cursor="Hand"
                    MouseLeftButtonUp="Preview_MouseLeftButtonUp"
                    ToolTip="Kliki, et liikuda ava juurde mudelis">
                    <Canvas
                        x:Name="PreviewCanvas"
                        Background="Transparent"
                        ClipToBounds="True" />
                </Border>

                <TextBlock
                    x:Name="DetailsPlaceholder"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource Type.Secondary}"
                    Text="Vali loendist ava, et näha selle üksikasju." />

                <Grid x:Name="DetailsGrid" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource DetailLabel}" Text="Allikas" />
                    <TextBlock
                        x:Name="DetailSource"
                        Grid.Column="1"
                        Style="{StaticResource DetailValue}" />
                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource DetailLabel}"
                        Text="Alus" />
                    <TextBlock
                        x:Name="DetailHost"
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource DetailValue}" />
                    <TextBlock
                        Grid.Row="2"
                        Style="{StaticResource DetailLabel}"
                        Text="Ava" />
                    <TextBlock
                        x:Name="DetailOpening"
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource DetailValue}" />
                    <TextBlock
                        Grid.Row="3"
                        Style="{StaticResource DetailLabel}"
                        Text="Staatus" />
                    <TextBlock
                        x:Name="DetailStatus"
                        Grid.Row="3"
                        Grid.Column="1"
                        Style="{StaticResource DetailValue}" />
                    <TextBlock
                        x:Name="DetailNotesLabel"
                        Grid.Row="4"
                        Style="{StaticResource DetailLabel}"
                        Text="Märkused" />
                    <TextBlock
                        x:Name="DetailNotes"
                        Grid.Row="4"
                        Grid.Column="1"
                        Style="{StaticResource DetailValue}" />
                </Grid>
            </Grid>
        </Border>

        <!--  Footer: transient status + bulk fix  -->
        <DockPanel Grid.Row="5" Margin="{StaticResource Gap.Top.M}">
            <Button
                x:Name="FixSelectedButton"
                Click="FixSelected_Click"
                DockPanel.Dock="Right"
                IsEnabled="False"
                Style="{StaticResource Button.Primary}"
                ToolTip="Paranda kõik valitud read (kinnitusega)">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AutoFix" Style="{StaticResource ButtonIconLabel}" />
                    <TextBlock x:Name="FixSelectedText" Text="Paranda valitud" />
                </StackPanel>
            </Button>
            <TextBlock
                x:Name="StatusMessageText"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Style="{StaticResource Type.Secondary}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </DockPanel>
    </Grid>
</UserControl>
