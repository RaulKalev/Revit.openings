<Window
    x:Class="RedeliAvad.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:RedeliAvad"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    Title="Avade loomine"
    Width="380"
    Height="720"
    MinWidth="360"
    MinHeight="560"
    Background="{DynamicResource Window.Background}"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStartupLocation="Manual">
    <!--
        Standard Windows frame behaviour (Aero Snap, native resize borders, DWM shadow, Windows 11 rounded corners)
        with the caption area drawn by the plugin. Modeless: shown with Show().
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="52"
            CornerRadius="0"
            GlassFrameThickness="0,0,0,1"
            NonClientFrameEdges="None"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Palette + materials are inserted at runtime by ThemeManager; styles use DynamicResource  -->
                <ResourceDictionary Source="pack://application:,,,/RedeliAvad;component/UI/Themes/DarkTheme.xaml" />
                <local:SharedDictionary Source="pack://application:,,,/RedeliAvad;component/UI/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Grouped-form row: label left, control right, hairline between rows  -->
            <Style x:Key="FormLabel" BasedOn="{StaticResource Type.Label}" TargetType="{x:Type TextBlock}">
                <Setter Property="Width" Value="104" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            </Style>
            <Style x:Key="RowSeparator" TargetType="{x:Type Border}">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="0,10" />
                <Setter Property="Background" Value="{DynamicResource Separator}" />
            </Style>
            <!--  Section caption above a card (sentence case, secondary)  -->
            <Style x:Key="SectionCaption" BasedOn="{StaticResource Type.Group}" TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="4,16,0,6" />
            </Style>
            <!--  Millimetre field: short, right-aligned number  -->
            <Style x:Key="Input.Mm" BasedOn="{StaticResource Input.Text}" TargetType="{x:Type TextBox}">
                <Setter Property="Width" Value="76" />
                <Setter Property="TextAlignment" Value="Right" />
            </Style>
            <Style x:Key="Unit" BasedOn="{StaticResource Type.Secondary}" TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid
        x:Name="RootGrid"
        Background="{DynamicResource Window.Background}"
        TextElement.FontFamily="{StaticResource Font.Text}"
        TextElement.FontSize="{StaticResource FontSize.Body}"
        TextElement.Foreground="{DynamicResource Text.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ============ Title area (draggable caption) ============  -->
        <DockPanel Background="{DynamicResource Toolbar.Material}">
            <StackPanel
                VerticalAlignment="Top"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="ThemeButton"
                    Margin="0,10,4,0"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="Switch between dark and light appearance"
                    Click="ToggleTheme_Click"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Vaheta tume / hele välimus"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon
                        x:Name="ThemeIcon"
                        Width="16"
                        Height="16"
                        Kind="WeatherNight" />
                </Button>
                <Button
                    AutomationProperties.Name="Minimize"
                    Click="Minimize_Click"
                    Style="{StaticResource CaptionButton}"
                    ToolTip="Minimeeri">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        Kind="WindowMinimize" />
                </Button>
                <Button
                    AutomationProperties.Name="Close"
                    Click="Close_Click"
                    Style="{StaticResource CaptionCloseButton}"
                    ToolTip="Sulge">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        Kind="WindowClose" />
                </Button>
            </StackPanel>

            <!--  App identity  -->
            <StackPanel Margin="16,0,8,0" Orientation="Horizontal">
                <Border
                    Width="26"
                    Height="26"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Accent}"
                    CornerRadius="7">
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Text.OnAccent}"
                        Kind="VectorIntersection" />
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="Avade loomine" />
                    <TextBlock
                        x:Name="DocumentTitleText"
                        MaxWidth="200"
                        FontSize="{StaticResource FontSize.Caption}"
                        Foreground="{DynamicResource Text.Tertiary}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
        <Border
            Height="1"
            VerticalAlignment="Bottom"
            Background="{DynamicResource Separator}" />

        <!--  ============ Content: left = creation form, right = Avade haldur (expands the window) ============  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="*" />
                <ColumnDefinition x:Name="ManagerColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <DockPanel>
                <!--  Sticky action bar: result line + the two placement actions  -->
                <Border
                    Background="{DynamicResource Toolbar.Material}"
                    BorderBrush="{DynamicResource Separator}"
                    BorderThickness="0,1,0,0"
                    DockPanel.Dock="Bottom">
                    <StackPanel Margin="16,12,16,14">
                        <DockPanel
                            x:Name="ResultLine"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">
                            <materialDesign:PackIcon
                                x:Name="ResultIcon"
                                Width="15"
                                Height="15"
                                Margin="0,1,8,0"
                                VerticalAlignment="Top"
                                Kind="InformationOutline" />
                            <TextBlock x:Name="ResultText" Style="{StaticResource Type.Secondary}" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Click="Run_Selected_Click"
                                Style="{StaticResource Button.Secondary}"
                                ToolTip="Loo avad ainult Revitis valitud kaablirennidele ja -ühendustele">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="SelectionDrag" Style="{StaticResource ButtonIconLabel}" />
                                    <TextBlock Text="Loo valitud" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="2"
                                Click="Run_Click"
                                Style="{StaticResource Button.Primary}"
                                ToolTip="Leia kõik kaablirennide ja seinte/talade ristumised ning loo neisse avad">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="VectorIntersection" Style="{StaticResource ButtonIconLabel}" />
                                    <TextBlock Text="Loo kõik avad" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <ScrollViewer
                    Focusable="False"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,0,16,16">

                        <!--  Model  -->
                        <TextBlock Style="{StaticResource SectionCaption}" Text="Mudel" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Seinad" />
                                    <ComboBox
                                        x:Name="LinkCombo"
                                        AutomationProperties.Name="Linked model containing walls"
                                        DisplayMemberPath="Name"
                                        Style="{StaticResource Input.Combo}"
                                        ToolTip="Lingitud mudel, mille seinte ja talade ristumistesse avad luuakse" />
                                </DockPanel>
                                <Border Style="{StaticResource RowSeparator}" />
                                <DockPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Ava perekond" />
                                    <ComboBox
                                        x:Name="FamilyCombo"
                                        AutomationProperties.Name="Opening family type"
                                        Style="{StaticResource Input.Combo}"
                                        ToolTip="Perekonna tüüp, millega avad luuakse">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                    <Run Foreground="{DynamicResource Text.Tertiary}" Text="{Binding Family.Name, Mode=OneWay, StringFormat=' · {0}'}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!--  Placement options  -->
                        <TextBlock Style="{StaticResource SectionCaption}" Text="Paigutus" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox
                                    x:Name="OnlyOncePerLocation"
                                    Content="Väldi duplikaate samas kohas"
                                    IsChecked="True"
                                    Style="{StaticResource Input.Check}" />
                                <TextBlock
                                    Margin="24,2,0,0"
                                    Style="{StaticResource Type.Caption}"
                                    Text="Olemasolevaga samasse kohta uut ava ei looda." />
                                <Border Style="{StaticResource RowSeparator}" />
                                <DockPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Tolerants" />
                                    <TextBlock
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource Unit}"
                                        Text="mm" />
                                    <TextBox
                                        x:Name="TolMmBox"
                                        HorizontalAlignment="Right"
                                        AutomationProperties.Name="Proximity tolerance in millimetres"
                                        Style="{StaticResource Input.Mm}"
                                        Text="10"
                                        ToolTip="Läheduse tolerants: selle kauguse sees loetakse avad samaks kohaks" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!--  Size additions  -->
                        <TextBlock Style="{StaticResource SectionCaption}" Text="Lisa ava mõõtudele" />
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="{StaticResource Gap.Bottom.XS}" Style="{StaticResource Type.Secondary}" Text="Laius" />
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="mm" />
                                        <TextBox
                                            x:Name="WidthExtensionBox"
                                            Width="Auto"
                                            AutomationProperties.Name="Width addition in millimetres"
                                            Style="{StaticResource Input.Mm}"
                                            Text="50" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="{StaticResource Gap.Bottom.XS}" Style="{StaticResource Type.Secondary}" Text="Sügavus" />
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="mm" />
                                        <TextBox
                                            x:Name="DepthExtensionBox"
                                            Width="Auto"
                                            AutomationProperties.Name="Depth addition in millimetres"
                                            Style="{StaticResource Input.Mm}"
                                            Text="50" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Margin="{StaticResource Gap.Bottom.XS}" Style="{StaticResource Type.Secondary}" Text="Kõrgus" />
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="mm" />
                                        <TextBox
                                            x:Name="HeightExtensionBox"
                                            Width="Auto"
                                            AutomationProperties.Name="Height addition in millimetres"
                                            Style="{StaticResource Input.Mm}"
                                            Text="50" />
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  Created openings  -->
                        <TextBlock Style="{StaticResource SectionCaption}" Text="Loodud avad" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button
                                        Click="Clear_Click"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource Button.Plain}"
                                        ToolTip="Unusta selle seansi jooksul loodud avad (mudelist midagi ei kustutata)">
                                        Tühjenda
                                    </Button>
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Margin="{StaticResource Gap.Right.S}"
                                            AutomationProperties.Name="Previous created opening"
                                            Click="Prev_Click"
                                            Style="{StaticResource Button.Secondary}"
                                            ToolTip="Näita eelmist loodud ava">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ChevronLeft" Style="{StaticResource ButtonIconLabel}" />
                                                <TextBlock Text="Eelmine" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            AutomationProperties.Name="Next created opening"
                                            Click="Next_Click"
                                            Style="{StaticResource Button.Secondary}"
                                            ToolTip="Näita järgmist loodud ava">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Järgmine" />
                                                <materialDesign:PackIcon
                                                    Margin="6,0,0,0"
                                                    Kind="ChevronRight"
                                                    Style="{StaticResource ButtonIconLabel}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource RowSeparator}" />
                                <!--  Disclosure into the manager panel  -->
                                <Button
                                    x:Name="ManagerToggleButton"
                                    Padding="10,0"
                                    HorizontalContentAlignment="Stretch"
                                    Click="OpenManager_Click"
                                    Style="{StaticResource Button.Plain}"
                                    ToolTip="Halda loodud avasid: valideeri, otsi, paranda, märgi lubatuks">
                                    <DockPanel>
                                        <materialDesign:PackIcon
                                            x:Name="ManagerChevron"
                                            Width="16"
                                            Height="16"
                                            VerticalAlignment="Center"
                                            DockPanel.Dock="Right"
                                            Foreground="{DynamicResource Text.Tertiary}"
                                            Kind="ChevronRight" />
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Kind="TableEye" />
                                        <TextBlock
                                            x:Name="ManagerToggleText"
                                            VerticalAlignment="Center"
                                            Text="Avade haldur" />
                                    </DockPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!--  Avade haldur (integrated panel)  -->
            <Border
                Grid.Column="1"
                Background="{DynamicResource Window.Background}"
                BorderBrush="{DynamicResource Separator}"
                BorderThickness="1,0,0,0">
                <local:OpeningManagerPanel
                    x:Name="ManagerPanel"
                    local:Motion.Reveal="True"
                    Visibility="Collapsed" />
            </Border>
        </Grid>

        <!--  ============ Sheet (in-window dialog) ============  -->
        <Grid
            x:Name="SheetHost"
            Grid.RowSpan="2"
            Visibility="Collapsed">
            <Border Background="{DynamicResource Scrim}" MouseLeftButtonDown="Scrim_MouseDown" />
            <Border
                x:Name="SheetCard"
                MaxWidth="440"
                Margin="16,56,16,16"
                Padding="20,18,20,16"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                KeyboardNavigation.ControlTabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Contained"
                KeyboardNavigation.TabNavigation="Cycle"
                Style="{StaticResource Floating}">
                <DockPanel>
                    <!--  Buttons: secondary left of primary; Enter = primary, Esc = secondary  -->
                    <StackPanel
                        Margin="0,18,0,0"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Bottom"
                        Orientation="Horizontal">
                        <Button
                            x:Name="SheetSecondary"
                            MinWidth="88"
                            Margin="0,0,8,0"
                            Click="SheetSecondary_Click"
                            Style="{StaticResource Button.Secondary}" />
                        <Button
                            x:Name="SheetPrimary"
                            MinWidth="88"
                            Click="SheetPrimary_Click"
                            Style="{StaticResource Button.Primary}" />
                    </StackPanel>

                    <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
                        <materialDesign:PackIcon
                            x:Name="SheetIcon"
                            Width="22"
                            Height="22"
                            Margin="0,0,12,0"
                            VerticalAlignment="Top"
                            Foreground="{DynamicResource Accent.Text}"
                            Kind="HelpCircleOutline" />
                        <TextBlock
                            x:Name="SheetTitle"
                            VerticalAlignment="Center"
                            Style="{StaticResource Type.Section}"
                            TextWrapping="Wrap" />
                    </DockPanel>

                    <ScrollViewer
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="34,0,0,0">
                            <TextBlock x:Name="SheetMessage" Style="{StaticResource Type.Body}" />
                            <StackPanel x:Name="SheetInputPanel" Margin="0,14,0,0">
                                <TextBlock
                                    x:Name="SheetInputLabel"
                                    Margin="{StaticResource Gap.Bottom.XS}"
                                    Style="{StaticResource Type.Secondary}" />
                                <TextBox x:Name="SheetInput" Style="{StaticResource Input.MultiLine}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
