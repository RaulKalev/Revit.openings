<Window
    x:Class="RedeliAvad.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:RedeliAvad"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Revision Control"
    Width="350"
    Height="480"
    MinWidth="350"
    MinHeight="480"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStartupLocation="Manual"
    WindowStyle="None">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!--  Material Design default theme  -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ComboBox.xaml" />
                <!--  Material Design dark theme  -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/RedeliAvad;component/UI/Themes/ElementStyles.xaml" />

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid
        Background="Transparent"
        ClipToBounds="True"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseMove="Window_MouseMove">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  Outer Border with Opacity and Blur  -->
        <Border
            Grid.RowSpan="2"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="2"
            ClipToBounds="True"
            CornerRadius="10"
            Opacity="0.7"
            SnapsToDevicePixels="True">
            <Border.Effect>
                <BlurEffect KernelType="Gaussian" Radius="2" />
            </Border.Effect>
        </Border>

        <!--  Content Container (Not Affected by Opacity/Blur)  -->
        <Border
            Grid.RowSpan="2"
            Margin="2,2,2,2"
            Background="{DynamicResource PrimaryBackgroundBrush}"
            CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Height="0.2"
                    Margin="-2,0,-2,-0.1"
                    VerticalAlignment="Bottom"
                    Background="Gray" />
                <!--  Custom Title Bar  -->
                <local:TitleBar
                    x:Name="TitleBarControl"
                    Title="Avade loomine"
                    Grid.Row="0"
                    Margin="0,0,0,1"
                    Foreground="{DynamicResource ForegroundBrush}" />

                <Grid
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,100,0"
                    HorizontalAlignment="Right">
                    <ToggleButton
                        x:Name="ThemeToggleButton"
                        Width="28"
                        Height="15.5"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="ToggleTheme_Click"
                        DockPanel.Dock="Right"
                        IsChecked="True"
                        ToolTip="Toggle Theme">

                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Grid Background="Transparent">

                                    <materialDesign:PackIcon
                                        x:Name="ThemeToggleIcon"
                                        Width="30"
                                        Height="30"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource IconBrush}"
                                        Kind="ToggleSwitchOffOutline" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="ThemeToggleIcon" Property="Kind" Value="ToggleSwitchOffOutline" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="ThemeToggleIcon" Property="Kind" Value="ToggleSwitchOutline" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>
                <!--  ==========================================================  -->
                <!--  MAIN CONTENT: left column = classic controls,               -->
                <!--  right column = Avade haldur panel (expands to the right)    -->
                <!--  ==========================================================  -->
                <Grid Grid.Row="1" Grid.RowSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftColumn" Width="*" />
                        <ColumnDefinition x:Name="ManagerColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Link & Family (MaterialDesign Card)  -->
                    <materialDesign:Card
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Margin="0,0,0,0"
                        Padding="8,6"
                        Background="{DynamicResource SecondaryBackgroundBrush}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Header  -->
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource ForegroundBrush}"
                                Text="Link &amp; Perekond" />

                            <Separator Grid.Row="1" Opacity="0.2" />

                            <!--  Body (2-column layout)  -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  Walls Link  -->
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,12,8"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    Text="Seinad mudelis:" />
                                <ComboBox
                                    x:Name="LinkCombo"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    MinWidth="200"
                                    Margin="0,0,0,8"
                                    materialDesign:HintAssist.Hint="Select linked model containing walls"
                                    Style="{StaticResource DarkThemeComboBox}" />

                                <!--  Family Type  -->
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,12,8"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    Text="Ava perekond:" />
                                <ComboBox
                                    x:Name="FamilyCombo"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    MinWidth="200"
                                    Margin="0,0,0,0"
                                    materialDesign:HintAssist.Hint="Generic Model / Specialty Equipment type"
                                    Style="{StaticResource DarkThemeComboBox}" />
                            </Grid>
                        </Grid>
                    </materialDesign:Card>

                    <!--  Valikud (MaterialDesign Card with 2-column body)  -->
                    <materialDesign:Card
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Margin="0,10,0,0"
                        Padding="8,6"
                        Background="{DynamicResource SecondaryBackgroundBrush}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  Header  -->
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource ForegroundBrush}"
                                Text="Valikud" />

                            <Separator Grid.Row="1" Opacity="0.2" />

                            <!--  Body (2-column grid)  -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <!--  checkbox  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  tolerants  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  laius  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  sügavus  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  kõrgus  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  info  -->
                                </Grid.RowDefinitions>

                                <!--  Väldi duplikaate  -->
                                <CheckBox
                                    x:Name="OnlyOncePerLocation"
                                    Grid.Row="0"
                                    Style="{StaticResource CustomCheckBox}"
                                    Grid.ColumnSpan="2"
                                    Margin="0,0,0,8"
                                    FontSize="10"
                                    Content="Väldi duplikaatpaigutusi samas kohas"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    IsChecked="True" />

                                <!--  Läheduse tolerants  -->
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,12,8"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    Text="Läheduse tolerants (mm):" />
                                <TextBox
                                    x:Name="TolMmBox"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Width="100"
                                    Height="24"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    FontSize="12"
                                    Style="{StaticResource CustomTextBoxStyle}"
                                    Text="10" />

                                <!--  Laiuse lisa  -->
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,0,12,8"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    Text="Laiuse lisa (mm):" />
                                <TextBox
                                    x:Name="WidthExtensionBox"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Width="100"
                                    Height="24"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    FontSize="12"
                                    Style="{StaticResource CustomTextBoxStyle}"
                                    Text="50" />

                                <!--  Sügavuse lisa  -->
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="0,0,12,8"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    Text="Sügavuse lisa (mm):" />
                                <TextBox
                                    x:Name="DepthExtensionBox"
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Width="100"
                                    Height="24"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    FontSize="12"
                                    Style="{StaticResource CustomTextBoxStyle}"
                                    Text="50" />

                                <!--  Kõrguse lisa  -->
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Margin="0,0,12,8"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    Text="Kõrguse lisa (mm):" />
                                <TextBox
                                    x:Name="HeightExtensionBox"
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Width="100"
                                    Height="24"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    FontSize="12"
                                    Style="{StaticResource CustomTextBoxStyle}"
                                    Text="50" />

                                <!--  Info  -->
                            </Grid>
                        </Grid>
                    </materialDesign:Card>

                </Grid>

                <!--  Bottom Bar (grouped)  -->
                <Grid
                    Grid.Row="1"
                    Margin="10,0,10,10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">
                    <StackPanel Orientation="Vertical">

                        <!--  Placement (MaterialDesign Card)  -->
                        <materialDesign:Card
                            Margin="0,0,0,0"
                            Padding="8,6"
                            Background="{DynamicResource SecondaryBackgroundBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  Header  -->
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    Text="Loo avad" />

                                <Separator Grid.Row="1" Opacity="0.2" />

                                <!--  Body  -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button
                                        Width="140"
                                        Height="30"
                                        Margin="0,5,10,0"
                                        HorizontalAlignment="Center"
                                        Click="Run_Click"
                                        Content="Loo kõik avad mudelis"
                                        FontSize="12"
                                        Style="{StaticResource CustomActionButtonStyle}" />
                                    <Button
                                        Width="140"
                                        Height="30"
                                        Margin="0,5,0,0"
                                        HorizontalAlignment="Center"
                                        Click="Run_Selected_Click"
                                        Content="Loo valitud avad"
                                        FontSize="12"
                                        Style="{StaticResource CustomActionButtonStyle}" />

                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>


                        <!--  Navigation (MaterialDesign Card)  -->
                        <materialDesign:Card
                            Margin="0,10,0,0"
                            Padding="8,6"
                            Background="{DynamicResource SecondaryBackgroundBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  Header  -->
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    Text="Näita loodud ava" />

                                <Separator Grid.Row="1" Opacity="0.2" />

                                <!--  Body  -->
                                <StackPanel Grid.Row="2" Orientation="Vertical">
                                    <StackPanel
                                        Margin="0,5,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Button
                                            Width="90"
                                            Height="30"
                                            Margin="0"
                                            Click="Prev_Click"
                                            Content="Eelmine"
                                            FontSize="12"
                                            Style="{StaticResource CustomActionButtonStyle}" />

                                        <Button
                                            Width="90"
                                            Height="30"
                                            Margin="10,0,0,0"
                                            Click="Next_Click"
                                            Content="Järgmine"
                                            FontSize="12"
                                            Style="{StaticResource CustomActionButtonStyle}" />

                                        <Button
                                            Width="90"
                                            Height="30"
                                            Margin="10,0,0,0"
                                            Click="Clear_Click"
                                            Content="Tühjenda mälu"
                                            FontSize="12"
                                            Style="{StaticResource CustomActionButtonStyle}" />
                                    </StackPanel>

                                    <!--  Opening Manager launcher  -->
                                    <Button
                                        x:Name="ManagerToggleButton"
                                        Width="290"
                                        Height="30"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        Click="OpenManager_Click"
                                        Content="Avade haldur"
                                        FontSize="12"
                                        Style="{StaticResource CustomActionButtonStyle}"
                                        ToolTip="Halda loodud avasid: valideeri, otsi, paranda, märgi lubatuks" />
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>


                    </StackPanel>
                </Grid>
                    </Grid>

                    <!--  Avade haldur (integrated panel, expands the window to the right)  -->
                    <local:OpeningManagerPanel
                        x:Name="ManagerPanel"
                        Grid.Column="1"
                        Margin="0,8,10,10"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>
        <!--  Left Edge  -->
        <Border
            x:Name="LeftEdge"
            Width="5"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Background="Transparent"
            Cursor="SizeWE"
            MouseLeftButtonDown="LeftEdge_MouseLeftButtonDown"
            MouseLeftButtonUp="Window_MouseLeftButtonUp"
            MouseMove="Window_MouseMove" />

        <!--  Right Edge  -->
        <Border
            x:Name="RightEdge"
            Width="5"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Background="Transparent"
            Cursor="SizeWE"
            MouseLeftButtonDown="RightEdge_MouseLeftButtonDown"
            MouseLeftButtonUp="Window_MouseLeftButtonUp"
            MouseMove="Window_MouseMove" />

        <!--  Bottom Edge  -->
        <Border
            x:Name="BottomEdge"
            Height="5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Panel.ZIndex="0"
            Background="Transparent"
            Cursor="SizeNS"
            MouseLeftButtonDown="BottomEdge_MouseLeftButtonDown"
            MouseLeftButtonUp="Window_MouseLeftButtonUp"
            MouseMove="Window_MouseMove" />

        <!--  Bottom-Left Corner  -->
        <Border
            x:Name="BottomLeftCorner"
            Width="10"
            Height="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Panel.ZIndex="1"
            Background="Transparent"
            Cursor="SizeNESW"
            MouseLeftButtonDown="BottomLeftCorner_MouseLeftButtonDown"
            MouseLeftButtonUp="Window_MouseLeftButtonUp"
            MouseMove="Window_MouseMove" />

        <!--  Bottom-Right Corner  -->
        <Border
            x:Name="BottomRightCorner"
            Width="10"
            Height="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Panel.ZIndex="1"
            Background="Transparent"
            Cursor="SizeNWSE"
            MouseLeftButtonDown="BottomRightCorner_MouseLeftButtonDown"
            MouseLeftButtonUp="Window_MouseLeftButtonUp"
            MouseMove="Window_MouseMove" />

    </Grid>
</Window>
